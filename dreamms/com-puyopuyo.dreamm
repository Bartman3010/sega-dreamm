//
// Puyo Puyo
//
desc[com-puyopuyo]:

name = Puyo Puyo
icon = com-puyopuyo.png
machine = pc
rootpath = C:\COMPILE\puyopuyo
launch = "$(rootpath)\$(EXENAME).exe"
osenv = windows 3.11.002
audiohw = gmidi
winres = 640x480x8
locale = ja-JP

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

//
// video configuration
//
config[video]:
    title = Video Configuration
    option[window]:  name = Cropped to Window; wincrop = true; priority = 1
    option[desktop]: name = Full Desktop;      wincrop = false
end

//
// Puyo Puyo for Windows
//
game[pc-w31-jp]:
    name = Puyo Puyo for Windows - Bothtec
    anchorfile = puyo.exe
	anchordepth = 1
