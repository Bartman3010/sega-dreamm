desc[sga-rally]:

name = Sega Rally Championship
icon = sga-rally.png
machine = pc
rootpath = C:\SEGA\SRALLY
launch = "$(rootpath)\rally.exe"
osenv = windows 95
audiohw = gmidi
winres = 1024x768x16

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)\CD

mount[cdw]: vpath = D:\; srcpath = ram
//
// initialization script
//
script[cd-ini-init]:
	code = [[[$(CRLF)
	    // set the volume label on the CD
        drive_set_label("D", "$$(CDLABEL)");
		file_save("C:\\WINDOWS\\Rally.ini", "$$(INI_CONTENTS)");
    ]]]
end

//
// Registry
//
REGISTRY = [[[$(CRLF)
    REGEDIT4
    [HKEY_LOCAL_MACHINE\SOFTWARE\SEGA\SEGA RALLY CHAMPIONSHIP\1.0]
@=""

]]]

script[registry-init]:
    code = [[[$(CRLF)
        winregistry_import_raw("$$(REGISTRY)");
    ]]]
end

//
// English CD
//
game[pc-en-cd-us]:
    name = US English CD
    anchorfile = rally.exe
	anchordepth = 2
