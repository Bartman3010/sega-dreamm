desc[sga-stcc]:

name = Sega Touring Car Championship
icon = sga-stcc.png
machine = pc
rootpath = C:\SEGA\TOURING CAR
launch = "$(rootpath)\stcc.exe"
osenv = windows 98
winres = 640x480x8

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)\CD

mount[cdw]: vpath = D:\; srcpath = ram

//
// initialization script
//
script[cd-ini-init]:
	code = [[[$(CRLF)
	    // set the volume label on the CD
        drive_set_label("D", "$$(CDLABEL)");
		file_save("C:\\WINDOWS\\stcc.ini", "$$(INI_CONTENTS)");
    ]]]
end

//
// Registry
//
REGISTRY = [[[$(CRLF)
    REGEDIT4
    [HKEY_LOCAL_MACHINE\Software\SEGA\SEGA Touring Car Championship]

    [HKEY_LOCAL_MACHINE\Software\SEGA\SEGA Touring Car Championship\1.0]
    @=""
    [HKEY_CURRENT_USER\Software\SEGA\SEGA Touring Car Championship for PC]

    [HKEY_CURRENT_USER\Software\SEGA\SEGA Touring Car Championship for PC\Settings]


]]]

script[registry-init]:
    code = [[[$(CRLF)
        winregistry_import_raw("$$(REGISTRY)");
    ]]]
end

//
// English CD
//
game[pc-en-cd]:
    name = English CD
    anchorfile = stcc.exe
	anchordepth = 2
