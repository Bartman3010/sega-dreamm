//
// Comix Zone 
//
desc[sga-comix]:

name = Comix Zone
icon = sga-comix.png
machine = pc
rootpath = C:\Sega\COMIX
launch = "$(rootpath)\comix.exe"
osenv = windows 95
audiohw = gmidi
winres = 640x480x8
filter = nonlucas
INIPATH = C:\\WINDOWS\\WIN.INI

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)\CD

//
// Windows OS Select
//
config[windows-os]:
    title = WINDOWS VERSION
    option[win31]:  name = Windows 3.1 (16-bit); osenv= windows 3.11.002
    option[win95]: name = Windows 95 (32-bit); priority = 1; osenv= windows 95
end

//
// video configuration
//
config[video]:
    title = Video Configuration
    option[window]:  name = Cropped to Window; wincrop = true; priority = 1
    option[desktop]: name = Full Desktop;      wincrop = false
end

//
// sound configuration
//
config[sound]:
    title = Sound Configuration
    option[mt32]:    name = $(MT32_NAME);    audiohw = mt32
    option[gmidi]:   name = $(GMIDI_NAME);   audiohw = gmidi; priority = 1
end

//
// System File
//
INIFILE = [[[$(CRLF)
	[Comix]
	path=C:\Sega\COMIX
	files=D:\
	
]]]
script[ini-init]:
	code = [[[$(CRLF)
		file_save("$$(INIPATH)", "$$(INIFILE)");
	]]]

end

//
//Auto Installer for Enhanced Edition on SEGA Puzzle Pack
//
fragment[install-base]:
	rootpath = D:\
	launch = D:\Setup.exe

	rootpath = C:\
end

fragment[common]:
    file[]: crc = dbe2da77; size =        53; name = CD\AUTORUN.INF
	
end

//
// Comix Zone CD US English
//
game[pc-en-cd-us]:
    name = English CD US
	//imports = common
    anchorfile = COMIX.EXE
    file[]: crc = 6412F028; size =      97577; name = COMIX.HLP //English US
	file[]: crc = 7402756D; size =    2013696; name = COMIX.EXE
	file[]: crc = B905B953; size =     117760; name = WAIL32.DLL
    file[]: crc = 115f1111; size =    1886781; name = SPRITES.BIN
end

